{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mona.app/contracts/common.schema.json",
  "title": "Common",
  "$defs": {
    "SchemaVersion": { "type": "integer", "minimum": 1, "maximum": 1 },
    "LocalDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "LocalTime": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
    "TimeZone": { "type": "string", "minLength": 1, "maxLength": 64 },
    "MomentAlias": { "type": "string", "pattern": "^m\\d{1,4}$" },
    "UtteranceAlias": { "type": "string", "pattern": "^u\\d{1,5}$" },
    "ItemAlias": { "type": "string", "pattern": "^i\\d{1,4}$" },
    "SpeakerToken": { "type": "string", "pattern": "^(ME|S\\d{1,3}|P\\d{1,3})$" },
    "ItemType": { "type": "string", "enum": ["promise", "decision", "fact", "question"] },
    "Confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "ModelVersion": { "type": "string", "minLength": 1, "maxLength": 128 }
  }
}
