{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mona.app/contracts/moment_label_response.schema.json",
  "title": "MomentLabelResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["scene", "tone", "title", "summary", "items", "minutes", "model_version"],
  "properties": {
    "scene": {
      "title": "SceneLabel",
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "confidence"],
      "properties": {
        "label": { "type": "string", "maxLength": 32 },
        "confidence": { "$ref": "common.schema.json#/$defs/Confidence" }
      }
    },
    "tone": { "title": "Tone", "type": "string", "enum": ["neutral", "positive", "negative", "conflict"] },
    "title": { "type": ["string", "null"], "maxLength": 200 },
    "summary": { "type": "string", "maxLength": 4000 },
    "items": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "title": "LabelItem",
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "text", "owner", "counterpart", "due", "sources", "confidence"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/ItemAlias" },
          "type": { "$ref": "common.schema.json#/$defs/ItemType" },
          "text": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "owner": { "anyOf": [{ "$ref": "common.schema.json#/$defs/SpeakerToken" }, { "type": "null" }] },
          "counterpart": { "anyOf": [{ "$ref": "common.schema.json#/$defs/SpeakerToken" }, { "type": "null" }] },
          "due": {
            "anyOf": [
              {
                "title": "Due",
                "type": "object",
                "additionalProperties": false,
                "required": ["phrase", "date"],
                "properties": {
                  "phrase": { "type": "string", "maxLength": 200 },
                  "date": { "anyOf": [{ "$ref": "common.schema.json#/$defs/LocalDate" }, { "type": "null" }] }
                }
              },
              { "type": "null" }
            ]
          },
          "sources": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/UtteranceAlias" } },
          "confidence": { "$ref": "common.schema.json#/$defs/Confidence" }
        }
      }
    },
    "minutes": {
      "anyOf": [
        {
          "title": "Minutes",
          "type": "object",
          "additionalProperties": false,
          "required": ["decisions", "promises", "open_questions", "follow_up_draft"],
          "properties": {
            "decisions": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/ItemAlias" } },
            "promises": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/ItemAlias" } },
            "open_questions": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/ItemAlias" } },
            "follow_up_draft": { "type": ["string", "null"], "maxLength": 8000 }
          }
        },
        { "type": "null" }
      ]
    },
    "model_version": { "$ref": "common.schema.json#/$defs/ModelVersion" }
  }
}
